{
  "name": "reuse-twin-student",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reuse Twin, student version (core 660901a): pages to build on, a core that only imports IFC files.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "core": "node scripts/start.mjs --core-only",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/api.gen.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
